{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Debug Lexy Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "env": {
        "WORKFLOW_DIR": "${workspaceFolder}/workflow",
        "HOST": "127.0.0.1",
        "PORT": "8080"
      },
      "cwd": "${workspaceFolder}",
      "args": [],
      "buildFlags": "",
      "dlvFlags": [],
      "preLaunchTask": "kill-ports",
      "postDebugTask": "kill-ports",
      "trace": "verbose"
    }
  ]
}
